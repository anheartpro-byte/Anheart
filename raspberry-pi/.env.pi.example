# AnHeart - configuration of the operator console ON THE RASPBERRY PI.
# Copy to .env (gitignored) and fill in:   cp .env.pi.example .env
# Every key is described in docs/raspberry-pi.md, section 12, and in .env.example.
# The console lists every problem at once at startup and exits with code 2.

# --- Link to the dashboard (Convex) ---------------------------------------
# The .convex.site host of the deployment, NOT .convex.cloud.
#   development: https://standing-jay-887.convex.site
#   production : https://clean-giraffe-153.convex.site
CONVEX_URL=https://standing-jay-887.convex.site
# 64 characters, shown ONCE when an admin creates the machine on the site.
# Leave empty to run the console with no link to the dashboard.
MACHINE_API_KEY=

# --- Drive: Schneider ATV320, Modbus RTU over the USB-RS485 cable ----------
MOTOR_BACKEND=serial
# /dev/ttyUSB0 when the kernel binds the adapter; otherwise the pyftdi URL
# ftdi://schneider:rs485/1 (Schneider's own cable, VID 0x16de).
MOTOR_PORT=/dev/ttyUSB0
MOTOR_SLAVE_ID=248
MODBUS_BAUDRATE=19200
MODBUS_PARITY=E
MOTOR_REG_OFFSET=0
# Bench ceiling on the motor shaft. Raise one deliberate step at a time.
MOTOR_MAX_RPM=300

# --- BITalino ---------------------------------------------------------------
# On the Pi the BITalino is read through a serial RFCOMM node. Pair it once on
# the host (scripts/pair_device.sh); the container binds the node at startup
# from BITALINO_MAC.
ECG_SOURCE=serial
BITALINO_ADDRESS=/dev/rfcomm0
BITALINO_MAC=98:D3:91:FE:4E:9F
SENSORS=ECG

# --- Geometry (MEASURE on the real machine) ---------------------------------
# Required, no default: distance from the axis to the occupant, in metres.
ARM_RADIUS_M=1.5
# The rider's farthest point from the axis (the CAD bounds it at 2.43 m).
LEG_TIP_RADIUS_M=2.43
GEAR_RATIO=49.79

# --- Operator page ----------------------------------------------------------
# Loopback only: the page is opened on the Pi's own screen (kiosk browser).
# A non-loopback UI_HOST requires a UI_TOKEN of at least 16 characters.
UI_HOST=127.0.0.1
UI_PORT=8090
# UI_TOKEN=

# --- What the machine is allowed to do --------------------------------------
# Both stay false until the milestones are signed off (M6 for a person on
# board, M5 for programmed sessions). With both false the machine offers
# MANUAL BENCH only and the dashboard's launch button never reaches it.
OCCUPANCY_OCCUPIED_ENABLED=false
PROGRAMS_ENABLED=false
MIN_RIDER_AGE=18
# HR_HARD_MAX_BPM=148
# HR_CRITICAL_BPM=158
PRESENCE_SOURCE=none

# --- Session record (the local black box) ------------------------------------
# Every session is written to disk as it runs, one directory per session.
# Relative to raspberry-pi/ unless absolute; created private (mode 700). A
# start is refused under 500 MB free there.
# RECORD_ROOT=data/records
# How long a record that was deposited off the machine AND confirmed is kept.
# A record that was not deposited is NEVER removed automatically.
# RECORD_LOCAL_RETENTION_DAYS=30
# Opaque identifiers written in each record's manifest (letters, digits, _ and
# -; never a name). "unassigned" when left out.
# RECORD_MACHINE_ID=
# RECORD_ORGANIZATION_ID=
# ANHEART_SOFTWARE_VERSION=
# Bench diagnostic of the drive link, off by default. With the real driver a
# record keeps the register transactions (what was asked of which register,
# what came back): about 0.2 MB a minute. "true" also keeps the Modbus SDK's
# own calls with their bytes (each request sent, each chunk received): about
# 0.95 MB a minute. No effect on the simulated drive.
# RECORD_DRIVE_SDK_FRAMES=false

# --- Signal processing ------------------------------------------------------
# biosppy imports matplotlib; without this it can try to open a GUI backend.
MPLBACKEND=Agg
