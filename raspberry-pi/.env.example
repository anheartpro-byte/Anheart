# AnHeart Raspberry Pi client - configuration template.
# Copy to .env and fill in. `.env` is gitignored; this template is not.

# --- Convex backend ------------------------------------------------------
# MUST be the .convex.site host, NOT .convex.cloud: HTTP actions live on
# .site and the .cloud host will silently 404 every request.
CONVEX_URL=https://your-deployment.convex.site
# 64-char key shown ONCE when you create a machine in the dashboard.
# The local console (python -m src.local_panel) links to the dashboard only
# when this key is set; blank = the console runs purely locally.
MACHINE_API_KEY=

# --- Acquisition ---------------------------------------------------------
# Windows: the OUTGOING Bluetooth SPP port, e.g. COM4. A MAC address would
# force the PyBluez path, which does not install on recent CPython.
# Linux/Pi: a MAC address (AA:BB:CC:DD:EE:FF) or /dev/rfcomm0.
BITALINO_MAC=COM4
SAMPLE_RATE=1000
OUTPUT_SAMPLE_RATE=250
BATCH_INTERVAL_MS=1000
HEARTBEAT_INTERVAL_S=30

# --- Storage / logging ---------------------------------------------------
BUFFER_DB_PATH=data/buffer.db
LOG_LEVEL=INFO
# biosppy imports matplotlib; without this it can try to open a GUI backend.
MPLBACKEND=Agg

# --- Motor drive (Schneider ATV320 over Modbus RTU) ---------------------
# MEASURED on this bench, do not guess these again:
#   address 248 is Schneider's point-to-point access address - the drive
#   answers on it whatever its configured Add is. Address 1 did NOT answer.
#   Register offset 0 is correct: at -1 the same reads return incoherent
#   values (ETA and ACC both 0x8000, which is not a valid status word).
#
# MOTOR_PORT is either an OS serial device or a pyftdi URL:
#   macOS, Schneider "USB - RS485 SL" cable (TCSMCNAM3M002P, FT232R,
#     VID 0x16de PID 0x0003): macOS creates NO /dev/cu.* for it, so use
#       MOTOR_PORT=ftdi://schneider:rs485/1
#     which goes through libusb (`brew install libusb`; no DYLD_* export is
#     needed, src/motor/ftdi_link.py finds Homebrew's copy itself). The port
#     used there reads a reply in tens of milliseconds; pyftdi's stock one
#     waited out the whole timeout on every read (2 s per register).
#   macOS, a generic FTDI/CH340 adapter that does get a device node:
#       MOTOR_PORT=/dev/cu.usbserial-XXXXXXXX
#   Windows: MOTOR_PORT=COM3
#   Raspberry Pi: MOTOR_PORT=/dev/ttyUSB0 (or the ftdi:// URL above if the
#     kernel does not bind ftdi_sio to Schneider's vendor id)
# MOTOR_SLAVE_ID=248 is accepted explicitly as Schneider's point-to-point
# address; 0 (broadcast) and anything else outside 1..247 is refused.
MOTOR_BACKEND=serial
MOTOR_PORT=ftdi://schneider:rs485/1
MOTOR_SLAVE_ID=248
MODBUS_BAUDRATE=19200
MODBUS_PARITY=E
MOTOR_REG_OFFSET=0
# Per-read serial timeout used by the bench scripts (bench_console.py,
# bench_comm_latency.py); unset = the driver default, 0.1 s. Measure the link
# with `python scripts/bench_comm_latency.py` (read-only) before changing it.
# MODBUS_TIMEOUT_S=0.1
# Software speed ceiling, deliberately far below the 1380 rpm nameplate.
# Raise one deliberate step at a time during commissioning.
MOTOR_MAX_RPM=300

# --- Local operator console (python -m src.local_panel) -----------------
# Read by src/local_config.py; every problem is reported at once at startup.
# MOTOR_BACKEND above is required: serial (the ATV320) or sim (SimulatedDrive).
# ECG source, required: sim | serial (/dev/rfcomm0, COM4) | rfcomm (macOS).
ECG_SOURCE=rfcomm
# rfcomm: needs rfcomm:XX-XX-XX-XX-XX-XX; serial: a device node or a MAC.
BITALINO_ADDRESS=rfcomm:98-d3-91-fe-4e-9f
# REQUIRED, no default: measured distance from the axis to the occupant, in m.
# Every g on the screen goes through it.
ARM_RADIUS_M=1.5
# The rider's farthest point from the axis: the anti-nausea g-rate limit is
# judged there. The CAD (simulation/cad/machine_geometry.json) bounds it at
# 2.43 m (feet against the capsule's far wall); MEASURE it on the real rider.
# Unset = judged at ARM_RADIUS_M, which understates the load at the feet.
LEG_TIP_RADIUS_M=2.43
# Gearbox ratio, confirmed on the bench (1380 motor rpm -> 14 turns in 30 s).
GEAR_RATIO=49.79
# Operator page. Not 8123: scripts/bench_console.py uses it. A non-loopback
# UI_HOST requires a UI_TOKEN of at least 16 characters.
UI_HOST=127.0.0.1
UI_PORT=8080
# UI_TOKEN=
# "Person on board" stays refused until milestone M6 (engineering + medical
# sign-off). With nobody on board (BENCH: motor uncoupled, or arm coupled with
# an empty capsule) the ceiling is MOTOR_MAX_RPM above, never above 1380.
OCCUPANCY_OCCUPIED_ENABLED=false

# --- Riders -------------------------------------------------------------------
# Youngest rider a PROGRAMMED (auto) session accepts; unknown age is refused too.
# [MED] 18 is a conservative default: lowering it is a medical decision.
MIN_RIDER_AGE=18

# --- Camera fail-safe -----------------------------------------------------------
# none (default) = no camera, the console runs as always. sim_empty / sim_occupied
# = a SIMULATED camera (capsule empty / rider buckled in), for the bench and the
# simulation only: a simulated camera never looks at the real machine.
# Rules (src/presence/README.md): intrusion while turning -> emergency stop;
# camera lost -> controlled stop; capsule empty with a rider declared -> refused.
PRESENCE_SOURCE=none

# --- BITalino channels acquired and shown ---------------------------------
# Comma list among ECG, EDA, SpO2, RESP, EMG, LUX. ECG is mandatory (the heart
# rate drives the motor); every other channel is MONITORING only and never
# changes what the controller is told. Each has its page on the console.
# SENSORS=ECG,EDA,SpO2,RESP,EMG,LUX
SENSORS=ECG

# --- Programmed (AUTO) sessions: the heart rate drives the speed ----------
# Milestone M5. A programme always has a person on board, so it ALSO needs
# OCCUPANCY_OCCUPIED_ENABLED=true and must fit under that ceiling. Only then
# will the dashboard's "launch" button reach this machine. Manual sessions are
# never launched from the dashboard, whatever this says.
PROGRAMS_ENABLED=false
# The supervisor's cardiac tiers, from the medical screening of the riders
# this machine is set up for. Every preset must carry the same two numbers or
# it is refused (and not offered on the dashboard). A ~150 bpm "jog" zone
# needs tiers above these defaults: a medical decision, made here.
# HR_HARD_MAX_BPM=148
# HR_CRITICAL_BPM=158
# MOTION_LIMITS_PATH=config/motion_limits.json
