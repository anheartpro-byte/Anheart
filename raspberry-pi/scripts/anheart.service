# AnHeart operator console, run NATIVELY from a venv (no Docker).
#
# The supported deployment is Docker (docker-compose.yml, restart policy
# included); use this unit only on a Pi where Docker is not wanted.
#
#   sudo cp scripts/anheart.service /etc/systemd/system/anheart.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now anheart
#
# Adjust User and the paths if the repository is not in /home/pi/anheart.
[Unit]
Description=AnHeart operator console (python -m src.local_panel)
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/anheart/raspberry-pi
# The console reads .env itself (python-dotenv); values here would override it.
Environment="PATH=/home/pi/anheart/raspberry-pi/.venv/bin:/usr/bin:/bin"
Environment="MPLBACKEND=Agg"
ExecStart=/home/pi/anheart/raspberry-pi/.venv/bin/python -m src.local_panel
# SIGTERM is the console's controlled stop: it zeroes the speed reference and
# releases the drive link. Give it time before systemd escalates to SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=60
# A restart never resumes motion: the console comes back at rest, read-only.
# Exit code 2 is a configuration error: restarting would only loop on it.
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anheart

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/anheart/raspberry-pi/data

[Install]
WantedBy=multi-user.target
