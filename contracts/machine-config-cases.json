{
  "description": "Cas de validation d'une configuration de machine (ANH-141). Chaque cas est la configuration `base` modifiée par `changes`, sans les clés de `remove`, jugée pour une machine validée jusqu'au niveau `level` (`none` sans lui), avec une console sans clé locale et des paramètres médicaux signés. `expected` est le verdict : `accepted`, ou `refused` avec chaque problème `{key, detail}`, dans l'ordre et les mots de la console. Lu par raspberry-pi/tests/test_machine_config_parity.py (review, raspberry-pi/src/machine_config.py) et par convex/machineConfigs.test.ts (machineConfigProblems, convex/lib/machineConfig.ts), qui exigent ce verdict des deux côtés.",
  "base": {
    "name": "Banc d'essai",
    "location": "Atelier Anheart",
    "SENSORS": [
      "ECG"
    ],
    "MOTOR_PORT": "ftdi://schneider:rs485/1",
    "MOTOR_SLAVE_ID": 248,
    "MODBUS_BAUDRATE": 19200,
    "MODBUS_PARITY": "E",
    "MODBUS_TIMEOUT_S": 0.1,
    "MOTOR_REG_OFFSET": 0,
    "ECG_SOURCE": "sim",
    "BITALINO_ADDRESS": null,
    "PRESENCE_SOURCE": "none",
    "UI_PORT": 8080,
    "GEAR_RATIO": 49.79,
    "RECORD_LOCAL_RETENTION_DAYS": 30,
    "MOTOR_BACKEND": "sim",
    "MOTOR_MAX_RPM": 300,
    "ARM_RADIUS_M": 1.5,
    "LEG_TIP_RADIUS_M": null,
    "PROGRAMS_ENABLED": false,
    "OCCUPANCY_OCCUPIED_ENABLED": false
  },
  "cases": [
